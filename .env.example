# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor (nunca NEXT_PUBLIC_): grava cache de mercado, histórico e logs.
SUPABASE_SERVICE_ROLE_KEY=

# ── Acesso ─────────────────────────────────────────────────
# Único e-mail autorizado. Qualquer outra conta é deslogada.
ALLOWED_EMAIL=
# MFA (TOTP) obrigatório. Só desative para testes.
REQUIRE_MFA=true
# UUID do usuário dono (auth.users.id) — usado pelo cron diário.
OWNER_USER_ID=
# Segredo do Vercel Cron (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# ── Dados de mercado (somente servidor) — todos em planos gratuitos ──
# composite (padrão) | finnhub | alphavantage | demo (apenas local)
MARKET_DATA_PROVIDER=composite
# Cotações realtime, fundamentos, notícias, consenso, calendário (60/min)
FINNHUB_API_KEY=
# Histórico diário ajustado e proventos (~1.000/dia) — https://www.tiingo.com
TIINGO_API_KEY=
# Revisões de estimativas e perfil de ETFs (25/dia; usada 1x/dia por ativo)
ALPHA_VANTAGE_API_KEY=
# true somente com plano PAGO da Alpha Vantage (volta a usá-la para cotação, notícias, câmbio e juros)
ALPHA_VANTAGE_REALTIME=false
# Câmbio (AwesomeAPI + Banco Central) e juros EUA (FRED) não precisam de chave.

# ── Leitura de comprovantes com IA (OPCIONAL, pago) ─────────
# A leitura padrão é gratuita e roda no navegador. Esta chave só habilita
# uma segunda tentativa com IA quando a leitura local fica incompleta.
ANTHROPIC_API_KEY=
# Modelo usado na leitura (padrão: claude-opus-5)
# LLM_MODEL=claude-opus-5

# ── Validade dos dados (segundos) ──────────────────────────
MAX_MARKET_DATA_AGE=30
MAX_MARKET_DATA_AGE_CLOSED=360000
MAX_FX_AGE=86400

# ── Desenvolvimento local (ignorado em produção) ───────────
# LOCAL_DEV_MODE=true   # sem Supabase/autenticação; dados em .dev-data.json
