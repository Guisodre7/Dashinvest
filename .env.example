# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor (nunca NEXT_PUBLIC_): grava cache de mercado, histórico e logs.
SUPABASE_SERVICE_ROLE_KEY=

# ── Acesso ─────────────────────────────────────────────────
# Único e-mail autorizado. Qualquer outra conta é deslogada.
ALLOWED_EMAIL=
# MFA (TOTP) obrigatório. Só desative para testes.
REQUIRE_MFA=true
# UUID do usuário dono (auth.users.id) — usado pelo cron diário.
OWNER_USER_ID=
# Segredo do Vercel Cron (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# ── Dados de mercado (somente servidor) ────────────────────
# composite (Finnhub + Alpha Vantage) | finnhub | alphavantage | demo (apenas local)
MARKET_DATA_PROVIDER=composite
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
# true somente se o plano Alpha Vantage contratado incluir cotações US em tempo real
ALPHA_VANTAGE_REALTIME=false

# ── Leitura de comprovantes (IA, somente servidor) ─────────
# Chave da API da Anthropic (console.anthropic.com). Sem ela, o botão
# "Ler comprovante" mostra um aviso e o registro manual continua funcionando.
ANTHROPIC_API_KEY=
# Modelo usado na leitura (padrão: claude-opus-5)
# LLM_MODEL=claude-opus-5

# ── Validade dos dados (segundos) ──────────────────────────
MAX_MARKET_DATA_AGE=30
MAX_MARKET_DATA_AGE_CLOSED=360000
MAX_FX_AGE=86400

# ── Desenvolvimento local (ignorado em produção) ───────────
# LOCAL_DEV_MODE=true   # sem Supabase/autenticação; dados em .dev-data.json
